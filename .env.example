# Copia este archivo como .env.local y llena los valores. .env.local NUNCA se sube a git.

# NEXT_PUBLIC_SUPABASE_URL — Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — Supabase Dashboard → Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY — Supabase Dashboard → Settings → API Keys → Secret key (o service_role). Solo servidor.
SUPABASE_SECRET_KEY=
# DATABASE_URL — Supabase Dashboard → Connect → Session pooler (con la contraseña de la base). Solo para `npm run migrate`.
DATABASE_URL=

# ANTHROPIC_API_KEY — tablero de raicode → card de Anthropic. Sin ella, trivia / esto o aquello / puzzle usan contenido de muestra.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL — opcional; modelo para generar contenido (por defecto claude-opus-5)
ANTHROPIC_MODEL=

# SLACK_CLIENT_ID — api.slack.com/apps → tu app "Rituales" → Basic Information → App Credentials
SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET — misma pantalla → Client Secret
SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET — misma pantalla → Signing Secret
SLACK_SIGNING_SECRET=

# CRON_SECRET — cadena aleatoria larga; protege /api/tick y /api/queue/fill. Vercel la manda sola en los crons.
CRON_SECRET=
# APP_URL — dirección pública de la app (https://….vercel.app). En local: http://localhost:3000
APP_URL=http://localhost:3000
